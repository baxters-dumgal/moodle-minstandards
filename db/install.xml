<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/minstandards/db"
       VERSION="2026060100"
       COMMENT="XMLDB file for mod_minstandards"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">

    <TABLES>

        <!-- Main activity table -->
        <TABLE NAME="minstandards" COMMENT="Main activity table">

            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="course" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
                <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true"/>
                <FIELD NAME="intro" TYPE="text" NOTNULL="false"/>
                <FIELD NAME="introformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
            </FIELDS>

            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>

        </TABLE>

        <!-- Checklist table -->
        <TABLE NAME="minstandards_checklist"
               COMMENT="Minimum standards checklist">

            <FIELDS>

                <FIELD NAME="id" TYPE="int" LENGTH="10"
                       NOTNULL="true" SEQUENCE="true"/>

                <FIELD NAME="minstandardsid" TYPE="int" LENGTH="10"
                       NOTNULL="true"/>

                <!-- Essential -->

                <FIELD NAME="clearstructure" TYPE="int" LENGTH="1"
                       NOTNULL="true" DEFAULT="0"/>

                <FIELD NAME="moduledescription" TYPE="int" LENGTH="1"
                       NOTNULL="true" DEFAULT="0"/>

                <FIELD NAME="staffcontact" TYPE="int" LENGTH="1"
                       NOTNULL="true" DEFAULT="0"/>

                <FIELD NAME="accessibility" TYPE="int" LENGTH="1"
                       NOTNULL="true" DEFAULT="0"/>

                <FIELD NAME="communication" TYPE="int" LENGTH="1"
                       NOTNULL="true" DEFAULT="0"/>

                <FIELD NAME="resources" TYPE="int" LENGTH="1"
                       NOTNULL="true" DEFAULT="0"/>

                <FIELD NAME="assessment" TYPE="int" LENGTH="1"
                       NOTNULL="true" DEFAULT="0"/>

                <FIELD NAME="feedback" TYPE="int" LENGTH="1"
                       NOTNULL="true" DEFAULT="0"/>

                <FIELD NAME="uptodatecontent" TYPE="int" LENGTH="1"
                       NOTNULL="true" DEFAULT="0"/>

                <FIELD NAME="expectations" TYPE="int" LENGTH="1"
                       NOTNULL="true" DEFAULT="0"/>

                <!-- Desirable -->

                <FIELD NAME="interactivity" TYPE="int" LENGTH="1"
                       NOTNULL="true" DEFAULT="0"/>

                <FIELD NAME="flexibility" TYPE="int" LENGTH="1"
                       NOTNULL="true" DEFAULT="0"/>

                <FIELD NAME="collaboration" TYPE="int" LENGTH="1"
                       NOTNULL="true" DEFAULT="0"/>

                <!-- Notes -->

                <FIELD NAME="notes" TYPE="text"
                       NOTNULL="false"/>

                <!-- Audit -->

                <FIELD NAME="useridmodified" TYPE="int" LENGTH="10"
                       NOTNULL="true" DEFAULT="0"/>

                <FIELD NAME="timecreated" TYPE="int" LENGTH="10"
                       NOTNULL="true" DEFAULT="0"/>

                <FIELD NAME="timemodified" TYPE="int" LENGTH="10"
                       NOTNULL="true" DEFAULT="0"/>

            </FIELDS>

            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>

                <KEY NAME="minstandards_fk"
                     TYPE="foreign"
                     FIELDS="minstandardsid"
                     REFTABLE="minstandards"
                     REFFIELDS="id"/>
            </KEYS>

        </TABLE>

        <!-- Reflective rubric -->

        <TABLE NAME="minstandards_rubric"
               COMMENT="Self reflection rubric">

            <FIELDS>

                <FIELD NAME="id" TYPE="int" LENGTH="10"
                       NOTNULL="true" SEQUENCE="true"/>

                <FIELD NAME="minstandardsid" TYPE="int" LENGTH="10"
                       NOTNULL="true"/>

                <!-- Rubric elements -->

                <FIELD NAME="welcomeinfo" TYPE="int" LENGTH="1"
                       NOTNULL="true" DEFAULT="0"/>

                <FIELD NAME="grammar" TYPE="int" LENGTH="1"
                       NOTNULL="true" DEFAULT="0"/>

                <FIELD NAME="presentation" TYPE="int" LENGTH="1"
                       NOTNULL="true" DEFAULT="0"/>

                <FIELD NAME="learningresources" TYPE="int" LENGTH="1"
                       NOTNULL="true" DEFAULT="0"/>

                <FIELD NAME="completion" TYPE="int" LENGTH="1"
                       NOTNULL="true" DEFAULT="0"/>

                <FIELD NAME="assessment" TYPE="int" LENGTH="1"
                       NOTNULL="true" DEFAULT="0"/>

                <FIELD NAME="accessibility" TYPE="int" LENGTH="1"
                       NOTNULL="true" DEFAULT="0"/>

                <FIELD NAME="digitaltools" TYPE="int" LENGTH="1"
                       NOTNULL="true" DEFAULT="0"/>

                <FIELD NAME="multimedia" TYPE="int" LENGTH="1"
                       NOTNULL="true" DEFAULT="0"/>

                <!-- Total -->

                <FIELD NAME="totalscore" TYPE="int" LENGTH="3"
                       NOTNULL="true" DEFAULT="0"/>

                <!-- Audit -->

                <FIELD NAME="useridmodified" TYPE="int" LENGTH="10"
                       NOTNULL="true" DEFAULT="0"/>

                <FIELD NAME="timecreated" TYPE="int" LENGTH="10"
                       NOTNULL="true" DEFAULT="0"/>

                <FIELD NAME="timemodified" TYPE="int" LENGTH="10"
                       NOTNULL="true" DEFAULT="0"/>

            </FIELDS>

            <KEYS>

                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>

                <KEY NAME="minstandards_fk"
                     TYPE="foreign"
                     FIELDS="minstandardsid"
                     REFTABLE="minstandards"
                     REFFIELDS="id"/>

            </KEYS>

        </TABLE>

    </TABLES>

</XMLDB>